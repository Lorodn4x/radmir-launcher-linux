{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RADMIR Standalone",
  "version": "0.1.1",
  "identifier": "games.radmir.standalone",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RADMIR Games — Standalone",
        "width": 1100,
        "height": 643,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "games",
        "depends": [
          "libc6 (>= 2.39)",
          "libgcc-s1",
          "libstdc++6",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64"
        ]
      }
    },
    "copyright": "Independent Linux launcher. Third-party names belong to their owners.",
    "category": "Game"
  }
}
